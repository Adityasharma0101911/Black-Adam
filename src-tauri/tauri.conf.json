{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Black Adam",
  "mainBinaryName": "black-adam",
  "version": "../package.json",
  "identifier": "com.adityasharma.blackadam",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Black Adam",
        "width": 1040,
        "height": 700,
        "minWidth": 360,
        "minHeight": 88,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#070707"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Identify any song playing on your computer",
    "copyright": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDNkI2MDc0MDUzMTEwNDIKUldSQ0VERUZkR0JyakV3M2dRQ2NyMGVtSnNHK3UvSW43eS9aVHpzaVVDRGtYZVYwL2VYOTM1WlYK",
      "endpoints": [
        "https://github.com/Adityasharma0101911/Black-Adam/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
